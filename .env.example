# Copy this file to .env on each laptop. Never commit the real .env file.

# Gaming laptop: 1. School server laptop: 0.
SMARTFARM_SIMULATION=1
SMARTFARM_AUTOMATION_ENABLED=0

# Keep disabled unless actuator power is removed and the Pico runtime upload
# has been explicitly approved for this hardware.
SMARTFARM_PICO_UPLOAD_ENABLED=0

# Keep both disabled until physical safety tests and emergency-stop tests pass.
SMARTFARM_CONTROL_ENABLED=0
SMARTFARM_CHEMICAL_CONTROL_ENABLED=0

# Allows only the user-configured LED photoperiod. Other actuator locks remain on.
SMARTFARM_LED_SCHEDULE_HARDWARE_ENABLED=0

# Optional browser login. Required before remote publication.
DASHBOARD_USERNAME=ffk
DASHBOARD_PASSWORD=CHANGE_TO_A_LONG_PASSWORD

# OpenAI Responses API. The report records the actual returned model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Telegram bot and the FFK team group chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hikvision ISAPI JPEG snapshot endpoints. Add only installed cameras.
CAMERA_1_LABEL=좌측 카메라
CAMERA_1_SNAPSHOT_URL=http://192.168.0.60/ISAPI/Streaming/channels/101/picture
CAMERA_1_USERNAME=admin
CAMERA_1_PASSWORD=
CAMERA_2_LABEL=중앙 카메라
CAMERA_2_SNAPSHOT_URL=http://192.168.0.61/ISAPI/Streaming/channels/101/picture
CAMERA_2_USERNAME=admin
CAMERA_2_PASSWORD=
CAMERA_3_LABEL=우측 카메라
CAMERA_3_SNAPSHOT_URL=http://192.168.0.62/ISAPI/Streaming/channels/101/picture
CAMERA_3_USERNAME=admin
CAMERA_3_PASSWORD=
CAMERA_4_LABEL=예비 카메라
CAMERA_4_SNAPSHOT_URL=
CAMERA_4_USERNAME=
CAMERA_4_PASSWORD=
